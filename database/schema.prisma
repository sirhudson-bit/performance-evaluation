// ---------------------------------------------------------------------------
// Performance management processes, agreements and cycle schedules
// ---------------------------------------------------------------------------

/// A reusable, versioned design for how performance is managed: an evaluation
/// model, target groups, the operational steps and their owners, and the
/// dimensions with a responsible party for each.
model PerformanceProcess {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  name           String
  description    String?
  evaluationModel String  @default("weighted_360") @map("evaluation_model")
  /// [{ type: 'unit'|'role'|'employee', id?: number, key?: string }]
  targetGroups   Json     @default("[]") @map("target_groups")
  status         String   @default("draft") // draft | active | archived
  version        Int      @default(1)
  createdBy      Int?     @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  steps        ProcessStep[]
  dimensions   ProcessDimension[]
  cycles       EvaluationCycle[]

  @@unique([organizationId, name, version])
  @@index([organizationId, status])
  @@map("performance_processes")
}

model ProcessStep {
  id           Int     @id @default(autoincrement())
  processId    Int     @map("process_id")
  name         String
  description  String?
  order        Int     @default(0)
  ownerType    String  @default("role") @map("owner_type") // role | user | unit
  ownerRoleKey String? @map("owner_role_key")
  ownerUserId  Int?    @map("owner_user_id")
  ownerUnitId  Int?    @map("owner_unit_id")
  slaDays      Int?    @map("sla_days")

  process PerformanceProcess @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@index([processId])
  @@map("process_steps")
}

model ProcessDimension {
  id           Int      @id @default(autoincrement())
  processId    Int      @map("process_id")
  name         String
  description  String?
  weight       Decimal  @default(0) @db.Decimal(7,3)
  ownerRoleKey String?  @map("owner_role_key")
  ownerUserId  Int?     @map("owner_user_id")
  sortOrder    Int      @default(0) @map("sort_order")

  process PerformanceProcess @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@index([processId])
  @@map("process_dimensions")
}

/// The concrete schedule of a process step for one cycle.
model CycleStep {
  id           Int       @id @default(autoincrement())
  cycleId      Int       @map("cycle_id")
  processStepId Int?     @map("process_step_id")
  name         String
  order        Int       @default(0)
  ownerRoleKey String?   @map("owner_role_key")
  ownerUserId  Int?      @map("owner_user_id")
  dueDate      DateTime? @map("due_date")
  status       String    @default("pending") // pending | in_progress | done

  cycle EvaluationCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([cycleId])
  @@map("cycle_steps")
}

/// An individual performance agreement: indicators with targets and actuals, a
/// progress percentage, and a log of events and feedback during the cycle.
model PerformanceAgreement {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  employeeId     Int       @map("employee_id")
  cycleId        Int?      @map("cycle_id")
  title          String
  description    String?
  status         String    @default("draft") // draft | active | completed | cancelled
  startDate      DateTime? @map("start_date")
  endDate        DateTime? @map("end_date")
  createdBy      Int?      @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  indicators   AgreementIndicator[]
  entries      AgreementEntry[]

  @@index([organizationId, employeeId])
  @@map("performance_agreements")
}

model AgreementIndicator {
  id          Int      @id @default(autoincrement())
  agreementId Int      @map("agreement_id")
  name        String
  description String?
  unit        String?
  targetValue Decimal? @db.Decimal(15,2) @map("target_value")
  actualValue Decimal? @db.Decimal(15,2) @map("actual_value")
  weight      Decimal  @default(1) @db.Decimal(7,3)
  progress    Int      @default(0) // 0..100
  sortOrder   Int      @default(0) @map("sort_order")

  agreement PerformanceAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  @@index([agreementId])
  @@map("agreement_indicators")
}

model AgreementEntry {
  id           Int      @id @default(autoincrement())
  agreementId  Int      @map("agreement_id")
  authorUserId Int?     @map("author_user_id")
  type         String   @default("feedback") // event | feedback | progress
  body         String
  createdAt    DateTime @default(now()) @map("created_at")

  agreement PerformanceAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  @@index([agreementId])
  @@map("agreement_entries")
}
