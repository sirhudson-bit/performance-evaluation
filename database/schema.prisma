// ===========================================================================
// سامانه ارزیابی عملکرد کارکنان — Prisma schema
//
// Conventions (matching the rest of the platform):
//   * snake_case tables/columns via @@map / @map.
//   * Money is Decimal(15,2), never floating point.
//   * Scores are Decimal(7,4) (4 dp internally).
//   * Status columns are String (not Postgres enums) so a new state never
//     requires a migration. Valid values live in @pe/shared ENUMS.
//   * Every organization-owned table carries organization_id so cross-org
//     scoping is enforced in one place. Single-record reads of a foreign id
//     resolve to 404 (never 403), so existence is never confirmed.
//   * "Actor" columns (created_by / actor_id) are plain indexed Int without a
//     foreign key on purpose: a user can be deactivated but their audit trail
//     must survive, and the authoritative actor record is audit_logs.
// ===========================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Organization, structure and people
// ---------------------------------------------------------------------------

model Organization {
  id        Int      @id @default(autoincrement())
  name      String
  legalName String?  @map("legal_name")
  slug      String   @unique
  status    String   @default("active") // active | suspended | archived
  timezone  String   @default("Asia/Tehran")
  locale    String   @default("fa-IR")
  calendar  String   @default("jalali") // jalali | gregorian
  currency  String   @default("IRT")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  units                  OrganizationUnit[]
  positions              Position[]
  employees              Employee[]
  users                  User[]
  roles                  Role[]
  questionCategories     QuestionCategory[]
  questions              Question[]
  forms                  EvaluationForm[]
  scoringPolicies        ScoringPolicyVersion[]
  workflows              Workflow[]
  periods                EvaluationPeriod[]
  cycles                 EvaluationCycle[]
  assignments            EvaluationAssignment[]
  responses              EvaluationResponse[]
  scores                 EvaluationScore[]
  results                FinalEvaluationResult[]
  reviews                EvaluationReview[]
  appeals                AppealRequest[]
  improvementPlans       ImprovementPlan[]
  compensationPolicies   CompensationPolicy[]
  compensationRecs       CompensationRecommendation[]
  compensationApprovals  CompensationApproval[]
  aiProviders            AiProvider[]
  aiUseCasePolicies      AiUseCasePolicy[]
  aiUsageEvents          AiUsageEvent[]
  aiConversations        AiConversation[]
  auditLogs              AuditLog[]
  notifications          Notification[]
  settings               Setting[]
  complianceProfile      ComplianceProfile?
  thirdPartyServices     ThirdPartyService[]
  consentPreferences     ConsentPreference[]
  importJobs             ImportJob[]
  exportJobs             ExportJob[]
  jobs                   Job[]
  helpArticles           HelpArticle[]
  helpFaqs               HelpFaq[]
  helpGlossary           HelpGlossary[]
  assets                 Asset[]
  tickets                SupportTicket[]
  processes              PerformanceProcess[]
  agreements             PerformanceAgreement[]

  @@map("organizations")
}

model OrganizationUnit {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  parentId       Int?      @map("parent_id")
  name           String
  code           String?
  type           String    @default("department") // department | subdepartment | team | division
  sortOrder      Int       @default(0) @map("sort_order")
  status         String    @default("active")
  effectiveFrom  DateTime? @map("effective_from")
  effectiveTo    DateTime? @map("effective_to")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       OrganizationUnit?  @relation("UnitTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     OrganizationUnit[] @relation("UnitTree")
  positions    Position[]
  employees    Employee[]
  users        User[]            @relation("UnitUsers")

  @@unique([organizationId, code])
  @@index([organizationId, parentId])
  @@map("organization_units")
}

model Position {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  unitId         Int?     @map("unit_id")
  title          String
  code           String?
  level          String?
  status         String   @default("active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  unit         OrganizationUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  employees    Employee[]

  @@unique([organizationId, code])
  @@index([organizationId, unitId])
  @@map("positions")
}

model Employee {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  userId         Int?      @unique @map("user_id")
  employeeNo     String    @map("employee_no")
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  displayName    String?   @map("display_name")
  // Optional contact fields — collected only when the organization needs them.
  email          String?
  phone          String?
  unitId         Int?      @map("unit_id")
  positionId     Int?      @map("position_id")
  managerId      Int?      @map("manager_id")
  hireDate       DateTime? @map("hire_date")
  status         String    @default("active") // active | inactive | terminated | archived
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  unit           OrganizationUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  position       Position?         @relation(fields: [positionId], references: [id], onDelete: SetNull)
  manager        Employee?         @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports        Employee[]        @relation("EmployeeManager")
  managerHistory EmployeeManagerHistory[] @relation("HistorySubject")
  managedHistory EmployeeManagerHistory[] @relation("HistoryManager")
  assignmentsSubject EvaluationAssignment[]
  appealRequests AppealRequest[]
  results        FinalEvaluationResult[]
  improvementPlans ImprovementPlan[]
  compensationRecs CompensationRecommendation[]
  agreements     PerformanceAgreement[]

  @@unique([organizationId, employeeNo])
  @@index([organizationId, unitId])
  @@index([organizationId, managerId])
  @@map("employees")
}

model EmployeeManagerHistory {
  id                Int       @id @default(autoincrement())
  organizationId    Int       @map("organization_id")
  employeeId        Int       @map("employee_id")
  managerEmployeeId Int?      @map("manager_employee_id")
  unitId            Int?      @map("unit_id")
  positionId        Int?      @map("position_id")
  effectiveFrom     DateTime  @map("effective_from")
  effectiveTo       DateTime? @map("effective_to")
  reason            String?
  createdAt         DateTime  @default(now()) @map("created_at")

  employee Employee  @relation("HistorySubject", fields: [employeeId], references: [id], onDelete: Cascade)
  manager  Employee? @relation("HistoryManager", fields: [managerEmployeeId], references: [id], onDelete: SetNull)

  @@index([organizationId, employeeId, effectiveFrom])
  @@map("employee_manager_history")
}

// ---------------------------------------------------------------------------
// Identity, sessions and access control
// ---------------------------------------------------------------------------

model User {
  id             Int       @id @default(autoincrement())
  organizationId Int?      @map("organization_id")
  name           String
  email          String
  phone          String?
  passwordHash   String    @map("password_hash")
  status         String    @default("active") // active | suspended | archived
  isPlatformAdmin Boolean  @default(false) @map("is_platform_admin")
  mfaEnabled     Boolean   @default(false) @map("mfa_enabled")
  mfaSecret      String?   @map("mfa_secret")
  preferredLanguage String @default("fa") @map("preferred_language")
  themePreference String @default("light") @map("theme_preference") // light | dark | system
  departmentId   Int?     @map("department_id")
  toursState     Json?    @map("tours_state")
  lastLoginAt    DateTime? @map("last_login_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   OrganizationUnit? @relation("UnitUsers", fields: [departmentId], references: [id], onDelete: SetNull)
  employee     Employee?
  sessions     Session[]
  roles        UserRole[]
  resetTokens  PasswordResetToken[]
  notifications Notification[]
  consentPreferences ConsentPreference[]
  helpProgress UserHelpProgress[]
  aiConversations AiConversation[]
  tickets      SupportTicket[] @relation("TicketCreator")
  assignedTickets SupportTicket[] @relation("TicketAssignee")
  ticketMessages TicketMessage[]

  @@unique([organizationId, email])
  @@index([email])
  @@map("users")
}

model Session {
  id           String   @id // opaque random token
  userId       Int      @map("user_id")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  payload      String   @default("{}")
  lastActivity Int      @map("last_activity") // unix seconds
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Role {
  id             Int      @id @default(autoincrement())
  organizationId Int?     @map("organization_id")
  key            String
  name           String
  description    String?
  isProtected    Boolean  @default(false) @map("is_protected")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  users        UserRole[]

  @@unique([organizationId, key])
  @@map("roles")
}

model Permission {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  category    String
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  roleId     Int      @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           Int @id @default(autoincrement())
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// Question bank (versioned)
// ---------------------------------------------------------------------------

model QuestionCategory {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  parentId       Int?     @map("parent_id")
  name           String
  sortOrder      Int      @default(0) @map("sort_order")
  status         String   @default("active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  questions    Question[]

  @@index([organizationId])
  @@map("question_categories")
}

model Question {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  stableKey      String   @map("stable_key") // stable identifier across versions
  categoryId     Int?     @map("category_id")
  title          String
  text           String
  guidance       String?
  // Person/class being evaluated (self | manager | employee | peer | report | other).
  subjectType    String   @default("employee") @map("subject_type")
  // Authorized respondents (evaluator roles), stored as JSON array.
  respondentRoles Json    @default("[]") @map("respondent_roles")
  answerType     String   @map("answer_type")
  required       Boolean  @default(true)
  weight         Decimal  @default(1) @db.Decimal(7,3)
  // Scoring criteria / bounds / multi-choice rule, e.g.
  // { max, min, unit, scale:[...], multiChoice:{mode,partial} }
  scoring        Json     @default("{}")
  // Conditional visibility rule, e.g. { when:{ questionStableKey, equals } }.
  condition      Json?    @map("condition")
  currentVersion Int      @default(1) @map("current_version")
  status         String   @default("draft") // draft | active | inactive | archived
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     QuestionCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  versions     QuestionVersion[]
  options      QuestionOption[]

  @@unique([organizationId, stableKey])
  @@index([organizationId, categoryId])
  @@index([organizationId, status])
  @@map("questions")
}

/// Immutable snapshot of a question at a point in time. A published form
/// references a QuestionVersion row, never the mutable Question.
model QuestionVersion {
  id           Int      @id @default(autoincrement())
  questionId   Int      @map("question_id")
  version      Int
  snapshot     Json     // full question + options + scoring at this version
  createdBy    Int?     @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")

  question    Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  formQuestions FormQuestion[]

  @@unique([questionId, version])
  @@map("question_versions")
}

model QuestionOption {
  id         Int      @id @default(autoincrement())
  questionId Int      @map("question_id")
  label      String
  value      String
  score      Decimal? @db.Decimal(7,3)
  isNotApplicable Boolean @default(false) @map("is_not_applicable")
  sortOrder  Int      @default(0) @map("sort_order")

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("question_options")
}

// ---------------------------------------------------------------------------
// Forms (versioned) and scoring policies
// ---------------------------------------------------------------------------

model ScoringPolicyVersion {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  name           String
  version        Int
  model          String   @default("normalized_weighted_average")
  config         Json     // round, requireComplete, allowWeightNormalization, weightTarget, unansweredPolicy
  status         String   @default("draft") // draft | active | archived
  createdBy      Int?     @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  formVersions FormVersion[]
  cycles       EvaluationCycle[]
  results      FinalEvaluationResult[]

  @@unique([organizationId, name, version])
  @@map("scoring_policy_versions")
}

model Workflow {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  name           String
  version        Int      @default(1)
  config         Json     // { selfAssessment, requiredEvaluators, stages:[...] }
  status         String   @default("active")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cycles       EvaluationCycle[]

  @@unique([organizationId, name, version])
  @@map("workflows")
}

model EvaluationForm {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  name           String
  description    String?
  status         String   @default("draft") // draft | published | archived
  currentVersion Int?     @map("current_version")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions     FormVersion[]

  @@index([organizationId])
  @@map("evaluation_forms")
}

/// A published form version is immutable: questions/options/scoring are frozen.
model FormVersion {
  id                  Int      @id @default(autoincrement())
  formId              Int      @map("form_id")
  version             Int
  status              String   @default("draft") // draft | in_review | published | archived
  scoringPolicyId     Int?     @map("scoring_policy_id")
  confidentialityMode String   @default("named") @map("confidentiality_mode") // named | confidential | anonymous
  selfAssessment      Boolean  @default(false) @map("self_assessment")
  // Peer/subject aggregation threshold for anonymised feedback.
  anonymityThreshold  Int      @default(3) @map("anonymity_threshold")
  notes               String?
  publishedAt         DateTime? @map("published_at")
  createdBy           Int?     @map("created_by")
  createdAt           DateTime @default(now()) @map("created_at")

  form           EvaluationForm  @relation(fields: [formId], references: [id], onDelete: Cascade)
  scoringPolicy  ScoringPolicyVersion? @relation(fields: [scoringPolicyId], references: [id], onDelete: SetNull)
  sections       FormSection[]
  questions      FormQuestion[]
  assignments    EvaluationAssignment[]
  cycles         EvaluationCycle[]

  @@unique([formId, version])
  @@map("form_versions")
}

model FormSection {
  id            Int      @id @default(autoincrement())
  formVersionId Int      @map("form_version_id")
  title         String
  description   String?
  weight        Decimal  @default(0) @db.Decimal(7,3)
  sortOrder     Int      @default(0) @map("sort_order")

  formVersion FormVersion   @relation(fields: [formVersionId], references: [id], onDelete: Cascade)
  questions   FormQuestion[]

  @@index([formVersionId])
  @@map("form_sections")
}

model FormQuestion {
  id                Int      @id @default(autoincrement())
  formVersionId     Int      @map("form_version_id")
  sectionId         Int      @map("section_id")
  questionVersionId Int      @map("question_version_id")
  weight            Decimal  @default(1) @db.Decimal(7,3)
  required          Boolean  @default(true)
  sortOrder         Int      @default(0) @map("sort_order")
  condition         Json?    // frozen conditional-visibility rule
  /// Calculated (quantitative) indicator: when true the answer is derived from
  /// other answers via `formula` instead of being entered directly.
  computed          Boolean  @default(false)
  formula           Json?    // { expression: "quality * 0.5 + teamwork * 0.5" }

  formVersion     FormVersion     @relation(fields: [formVersionId], references: [id], onDelete: Cascade)
  section         FormSection     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  questionVersion QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Restrict)

  @@index([formVersionId])
  @@index([sectionId])
  @@map("form_questions")
}

// ---------------------------------------------------------------------------
// Evaluation periods, cycles and assignments
// ---------------------------------------------------------------------------

model EvaluationPeriod {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  name           String
  type           String   @default("custom") // monthly | quarterly | annual | custom
  startDate      DateTime @map("start_date")
  endDate        DateTime @map("end_date")
  status         String   @default("active")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cycles       EvaluationCycle[]

  @@index([organizationId])
  @@map("evaluation_periods")
}

model EvaluationCycle {
  id                   Int       @id @default(autoincrement())
  organizationId       Int       @map("organization_id")
  periodId             Int?      @map("period_id")
  name                 String
  formVersionId        Int       @map("form_version_id")
  workflowId           Int?      @map("workflow_id")
  scoringPolicyId      Int?      @map("scoring_policy_id")
  compensationPolicyId Int?      @map("compensation_policy_id")
  processId            Int?      @map("process_id")
  confidentialityMode  String    @default("named") @map("confidentiality_mode")
  selfAssessment       Boolean   @default(false) @map("self_assessment")
  appealEnabled        Boolean   @default(false) @map("appeal_enabled")
  startDate            DateTime  @map("start_date")
  endDate              DateTime  @map("end_date")
  submissionDeadline   DateTime? @map("submission_deadline")
  publicationRule      String    @default("auto_on_approve") @map("publication_rule") // auto_on_approve | manual
  status               String    @default("draft") // draft | active | in_review | published | closed | cancelled
  config               Json      @default("{}")
  createdBy            Int?      @map("created_by")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  period         EvaluationPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)
  formVersion    FormVersion     @relation(fields: [formVersionId], references: [id], onDelete: Restrict)
  workflow       Workflow?       @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  scoringPolicy  ScoringPolicyVersion? @relation(fields: [scoringPolicyId], references: [id], onDelete: SetNull)
  compensationPolicy CompensationPolicy? @relation(fields: [compensationPolicyId], references: [id], onDelete: SetNull)
  process        PerformanceProcess? @relation(fields: [processId], references: [id], onDelete: SetNull)
  assignments    EvaluationAssignment[]
  results        FinalEvaluationResult[]
  appeals        AppealRequest[]
  steps          CycleStep[]

  @@index([organizationId, status])
  @@map("evaluation_cycles")
}

model EvaluationAssignment {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  cycleId        Int       @map("cycle_id")
  employeeId     Int       @map("employee_id")
  evaluatorRole  String    @map("evaluator_role") // self | manager | peer | report | hr | other
  evaluatorUserId Int?     @map("evaluator_user_id")
  evaluatorEmployeeId Int? @map("evaluator_employee_id")
  weight         Decimal   @default(0) @db.Decimal(7,3)
  status         String    @default("draft")
  dueDate        DateTime? @map("due_date")
  submittedAt    DateTime? @map("submitted_at")
  formVersionId  Int       @map("form_version_id")
  // Snapshot of questions/weights at assignment time (belt-and-braces immutability).
  versionSnapshot Json?    @map("version_snapshot")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cycle        EvaluationCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  formVersion  FormVersion   @relation(fields: [formVersionId], references: [id], onDelete: Restrict)
  responses    EvaluationResponse[]
  scores       EvaluationScore[]
  reviews      EvaluationReview[]

  @@unique([cycleId, employeeId, evaluatorRole, evaluatorUserId])
  @@index([organizationId, evaluatorUserId, status])
  @@index([cycleId, status])
  @@map("evaluation_assignments")
}

model EvaluationResponse {
  id                Int      @id @default(autoincrement())
  organizationId    Int      @map("organization_id")
  assignmentId      Int      @map("assignment_id")
  formQuestionId    Int      @map("form_question_id")
  questionVersionId Int      @map("question_version_id")
  answerType        String   @map("answer_type")
  value             Json     @default("{}") // raw answer (option values, text, number…)
  score             Decimal? @db.Decimal(7,4) // normalized 0–100, null when text/NA
  isNotApplicable   Boolean  @default(false) @map("is_not_applicable")
  answeredAt        DateTime @default(now()) @map("answered_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignment   EvaluationAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, formQuestionId])
  @@index([assignmentId])
  @@map("evaluation_responses")
}

model EvaluationScore {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  assignmentId   Int      @map("assignment_id")
  sectionId      Int?     @map("section_id")
  sectionScore   Decimal? @db.Decimal(7,4) @map("section_score")
  formScore      Decimal? @db.Decimal(7,4) @map("form_score")
  detail         Json     @default("{}")
  computedAt     DateTime @default(now()) @map("computed_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignment   EvaluationAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@map("evaluation_scores")
}

model FinalEvaluationResult {
  id                   Int      @id @default(autoincrement())
  organizationId       Int      @map("organization_id")
  cycleId              Int      @map("cycle_id")
  employeeId           Int      @map("employee_id")
  finalScore           Decimal? @db.Decimal(7,4) @map("final_score")
  scoringPolicyVersionId Int?   @map("scoring_policy_version_id")
