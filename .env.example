# ---------------------------------------------------------------------------
# سامانه ارزیابی عملکرد — environment template
#
# Copy to `.env` and fill in. NEVER commit a real `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (schema is created by Prisma migrations).
# The default run path uses a local PostgreSQL on port 55433 (a dedicated
# cluster started from the project — see README). Point this at any server.
DATABASE_URL="postgresql://postgres:CHANGE_ME@127.0.0.1:55433/performance_evaluation?schema=public"

# 32-byte base64 key. Signs session/CSRF tokens and encrypts stored provider
# credentials (AES-256-GCM). Treat as permanent once data exists — changing it
# makes previously encrypted secrets unreadable.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_KEY=""

# Bearer token for the background job drain endpoint (POST /api/v1/jobs/run).
CRON_SECRET=""

# Public origin of the web app (used for links and CORS allow-list).
APP_URL="http://localhost:3000"
APP_NAME="سامانه ارزیابی عملکرد"

# API service
API_PORT="4000"
API_URL="http://127.0.0.1:4000"
# Bind address for the API. Leave unset inside Docker (0.0.0.0); set 127.0.0.1
# when the API runs on the host behind the Next.js proxy.
API_HOST="127.0.0.1"

# Cookie name for the session (HttpOnly, SameSite=Lax).
SESSION_COOKIE_NAME="pe_session"

# Session lifetime in seconds (default 12h, sliding).
SESSION_TTL_SECONDS="43200"

# --- Optional integrations (graceful degradation when unset) ---------------

# SMTP for transactional notifications. When unset, reset/notification mail is
# written to the log/queued rather than sent, and the admin UI says so.
SMTP_HOST=""
SMTP_PORT=""
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Set "false" for a clean install with no demo organization/data.
SEED_DEMO_DATA="true"

# Bootstrap administrator created by the seed (dev only). If SEED_ADMIN_PASSWORD
# is left empty, the seed generates a random password and prints it once.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""

# Node environment
NODE_ENV="development"
